# Pooled Supavisor connection (transaction mode, port 6543) — app runtime
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — drizzle-kit migrations only, never the app
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth (auth flows only — never data)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Canonical URL for auth redirects and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenFreeMap style URL — the one-config-value tile-provider swap
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Salt for anonymous problem-report IP hashing (never store raw IPs)
IP_HASH_SALT=change-me-to-a-long-random-string

# Vercel Blob — admin venue photo uploads (auto-provisioned once a Blob
# store is linked to the Vercel project; `vercel env pull` fetches it locally)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx_example
