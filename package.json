{
  "name": "tueats",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:kml": "tsx --env-file=.env.local scripts/seed-kml.ts",
    "enrich:venues": "tsx --env-file=.env.local scripts/enrich-venues/apply.ts",
    "backfill:map-zones": "tsx --env-file=.env.local scripts/backfill-map-zones.ts",
    "refresh:dev-from-prod": "tsx --env-file=.env.local --env-file=.env.prod-readonly.local scripts/refresh-dev-from-prod.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.20",
    "postgres": "^3.4.9",
    "posthog-js": "^1.426.1",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.20",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
